                <div class="text-xs text-slate-600">💆 ${o.servicesSummary}</div>
                <div class="text-xs text-slate-600">👥 ${o.totalParticipants} Peserta (${o.maleCount} Pria, ${o.femaleCount} Wanita)</div>
                <div class="text-xs text-slate-600">📍 ${o.locationType} (${o.serviceAddress})</div>
                <div class="pt-2 border-t border-slate-100 flex justify-between items-center">
                  <span class="font-bold text-sm text-netraGreen">${formatRupiah(o.totalPayment)}</span>
                  <div class="flex gap-2">
                    <button onclick="copyText('${o.orderId} - ${o.servicesSummary} - ${formatRupiah(o.totalPayment)}', 'Rincian pesanan')" class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs font-semibold">
                      Salin
                    </button>
                    <button onclick="openWhatsAppForOrder('${o.orderId}')" class="px-3 py-1.5 bg-netraGreen text-white rounded-lg text-xs font-bold">
                      Kirim WA
                    </button>
                  </div>
                </div>
              </div>
            `;
          }).join("")}
        </div>
      `;
    }

    function renderProfileTab() {
      const u = state.currentUser;
      const avatarSrc = u.photoUri || "assets/aistudio/mitranetraqu_9e70e9c3.jpeg";
      return `
        <div class="space-y-4">
          <!-- Kartu Profil & Foto -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col items-center text-center">
            <img src="${avatarSrc}" class="w-24 h-24 rounded-full object-cover border-2 border-netraBlue mb-2" />
            <label class="cursor-pointer text-xs font-bold text-netraBlue underline mb-2">
              📷 Ganti Foto Profil
              <input type="file" accept="image/*" class="hidden" onchange="handlePhotoUpload(event)" />
            </label>
            <h2 class="font-bold text-lg text-netraBlue">${u.fullName}</h2>
            <p class="text-xs text-slate-500">${u.phone}</p>

            <!-- Ubah Jenis Kelamin -->
            <div class="mt-3 flex items-center gap-2">
              <span class="text-xs font-semibold text-slate-600">Jenis Kelamin:</span>
              <select onchange="updateUserGender(this.value)" class="text-xs font-bold border border-netraBlue/40 rounded-full px-3 py-1 bg-netraBlueLight text-netraBlue">
                <option value="Laki-laki" ${u.gender === 'Laki-laki' ? 'selected' : ''}>Laki-laki</option>
                <option value="Perempuan" ${u.gender === 'Perempuan' ? 'selected' : ''}>Perempuan</option>
              </select>
            </div>
          </div>

          <!-- Info Kontak dengan Tombol Copy -->
          <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-2.5 text-xs">
            <div class="font-bold text-sm text-netraBlue mb-1">Informasi Pelanggan (Bisa Copy-Paste)</div>
            <div class="flex justify-between items-center">
              <div><span class="text-slate-500">Nomor HP:</span> <strong>${u.phone}</strong></div>
              <button onclick="copyText('${u.phone}', 'Nomor HP')" class="text-netraBlue font-bold">Salin</button>
            </div>
            <div class="flex justify-between items-center">
              <div><span class="text-slate-500">Alamat:</span> <strong>${u.address}</strong></div>
              <button onclick="copyText('${u.address}', 'Alamat')" class="text-netraBlue font-bold">Salin</button>
            </div>
          </div>

          <button onclick="logout()" class="w-full border border-red-500 text-red-600 font-bold py-3 rounded-xl text-sm">
            Keluar dari Akun
          </button>
        </div>
      `;
    }

    // 3. HALAMAN DASHBOARD ADMINISTRATOR (No HP: 081212345678, Pass: 198006)
    function renderAdminScreen() {
      const allOrders = getOrders();
      const allUsers = getUsers();
      const todayIso = new Date().toISOString().split("T")[0];

      const filteredOrders = allOrders.filter(o => {
        if (state.adminDateFilter === "TODAY" && o.bookingDate !== todayIso) return false;
        if (state.adminDateFilter === "SPECIFIC" && state.adminSpecificDate && o.bookingDate !== state.adminSpecificDate) return false;
        if (state.adminSearch) {
          const q = state.adminSearch.toLowerCase();
          return (
            o.customerName.toLowerCase().includes(q) ||
            o.customerPhone.includes(q) ||
            o.orderId.toLowerCase().includes(q)
          );
        }
        return true;
      });

      const totalRevenue = filteredOrders.reduce((acc, o) => acc + Number(o.totalPayment || 0), 0);

      return `
        <div class="bg-netraBlue text-white p-4 flex justify-between items-center shadow">
          <div>
            <h1 class="font-bold text-base">Dashboard Administrator</h1>
            <p class="text-[11px] text-white/80">Mitra NetraQu Palembang • Admin (${ADMIN_PHONE})</p>
          </div>
          <button onclick="logout()" class="bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg text-xs font-bold">
            Keluar
          </button>
        </div>

        <div class="p-4 space-y-4 flex-1 overflow-y-auto">
          <!-- Ringkasan Statistik -->
          <div class="grid grid-cols-3 gap-2">
            <div class="bg-netraBlueLight p-3 rounded-xl border border-netraBlue/20">
              <div class="text-[11px] text-slate-600">Pesanan Masuk</div>
              <div class="text-lg font-extrabold text-netraBlue">${filteredOrders.length}</div>
            </div>
            <div class="bg-netraGreenLight p-3 rounded-xl border border-netraGreen/20">
              <div class="text-[11px] text-slate-600">Total Transaksi</div>
              <div class="text-xs font-extrabold text-netraGreen mt-1">${formatRupiah(totalRevenue)}</div>
            </div>
            <div class="bg-slate-100 p-3 rounded-xl border border-slate-200">
              <div class="text-[11px] text-slate-600">Total Pengguna</div>
              <div class="text-lg font-extrabold text-slate-800">${allUsers.length}</div>
            </div>
          </div>

          <!-- Filter Tanggal & Pencarian -->
          <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-2">
            <div class="text-xs font-bold text-netraBlue">Filter Tanggal Pesanan:</div>
            <div class="flex gap-1.5 flex-wrap">
              <button onclick="state.adminDateFilter='ALL'; render();" class="px-2.5 py-1 rounded-lg text-xs font-bold ${state.adminDateFilter==='ALL' ? 'bg-netraBlue text-white' : 'bg-slate-100 text-slate-700'}">Semua</button>
              <button onclick="state.adminDateFilter='TODAY'; render();" class="px-2.5 py-1 rounded-lg text-xs font-bold ${state.adminDateFilter==='TODAY' ? 'bg-netraBlue text-white' : 'bg-slate-100 text-slate-700'}">Hari Ini</button>
              <input type="date" value="${state.adminSpecificDate}" onchange="state.adminDateFilter='SPECIFIC'; state.adminSpecificDate=this.value; render();" class="border border-slate-300 rounded-lg px-2 py-0.5 text-xs" />
            </div>
            <input type="text" placeholder="Cari nama, nomor HP, atau ID pesanan..." value="${state.adminSearch}" oninput="state.adminSearch=this.value; render();" class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-xs" />
          </div>

          <!-- Tab Switcher Admin -->
          <div class="grid grid-cols-2 bg-slate-200 p-1 rounded-xl">
            <button onclick="state.adminTab=0; render();" class="py-2 rounded-lg text-xs font-bold ${state.adminTab===0 ? 'bg-white text-netraBlue shadow' : 'text-slate-600'}">
              📦 Pesanan Masuk (${filteredOrders.length})
            </button>
            <button onclick="state.adminTab=1; render();" class="py-2 rounded-lg text-xs font-bold ${state.adminTab===1 ? 'bg-white text-netraBlue shadow' : 'text-slate-600'}">
              👥 Data Pengguna (${allUsers.length})
            </button>
          </div>

          ${state.adminTab === 0 ? `
            <div class="space-y-3">
              ${filteredOrders.map(o => {
                const st = getStatusObj(o.status);
                return `
                  <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-2">
                    <div class="flex justify-between items-start">
                      <div>
                        <span class="font-bold text-sm text-netraBlue">${o.orderId}</span>
                        <div class="text-xs font-bold text-slate-800">${o.customerName} (${o.customerPhone})</div>
                      </div>
                      <span class="text-[11px] font-bold px-2.5 py-1 rounded-full ${st.bg} ${st.text}">
                        ${st.label} (${st.step})
                      </span>
                    </div>
                    <div class="text-xs text-slate-600">📅 ${o.bookingDate} • ${o.timeSlot}</div>
                    <div class="text-xs text-slate-600">💆 ${o.servicesSummary} (${o.totalParticipants} Orang)</div>
                    <div class="text-xs text-slate-600">📍 ${o.locationType}: ${o.serviceAddress}</div>
                    <div class="text-xs font-bold text-netraGreen">${formatRupiah(o.totalPayment)}</div>

                    <!-- Kontrol Ubah 7 Status Pesanan Khusus Admin -->
                    <div class="pt-2 border-t border-slate-100">
                      <label class="block text-[11px] font-bold text-netraBlue mb-1">Ubah Status Pesanan (Khusus Admin):</label>
                      <select onchange="adminChangeOrderStatus('${o.orderId}', this.value)" class="w-full border border-netraBlue/40 rounded-xl px-3 py-2 text-xs font-bold bg-netraBlueLight/40 text-slate-800">
                        ${ORDER_STATUSES.map(s => `
                          <option value="${s.code}" ${o.status === s.code ? 'selected' : ''}>
                            ${s.step} - ${s.label}
                          </option>
                        `).join("")}
                      </select>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>
          ` : `
            <div class="space-y-2.5">
              ${allUsers.map(u => `
                <div class="bg-white border border-slate-200 rounded-2xl p-3.5 shadow-sm flex justify-between items-center">
                  <div class="text-xs space-y-0.5">
                    <div class="font-bold text-sm text-netraBlue">${u.fullName}</div>
                    <div class="text-slate-600">📱 ${u.phone} • ${u.gender}</div>
                    <div class="text-slate-500">📍 ${u.address}</div>
                  </div>
                  <button onclick="copyText('${u.fullName} - ${u.phone} - ${u.address}', 'Data pengguna')" class="px-2.5 py-1.5 border border-slate-300 rounded-lg text-xs font-bold text-netraBlue">
                    Salin
                  </button>
                </div>
              `).join("")}
            </div>
          `}
        </div>
      `;
    }

    // --- EVENT HANDLERS ---
    function setAuthTab(idx) {
      state.authTab = idx;
      render();
    }

    function toggleRegisterMode() {
      state.isRegister = !state.isRegister;
      render();
    }

    function setCustomerTab(idx) {
      state.customerTab = idx;
      render();
    }

    function handlePhoneLogin() {
      const phone = document.getElementById("loginPhone").value.trim();
      const pin = document.getElementById("loginPin").value.trim();

      if (phone === ADMIN_PHONE && pin === ADMIN_PASS) {
        state.currentUser = { fullName: "Administrator Mitra NetraQu", phone: ADMIN_PHONE, isAdmin: true };
        localStorage.setItem("mnq_current_user", JSON.stringify(state.currentUser));
        state.screen = "admin";
        showToast("Selamat datang di Dashboard Administrator");
        render();
        return;
      }

      if (phone === ADMIN_PHONE && pin !== ADMIN_PASS) {
        showToast("Password Administrator salah!");
        return;
      }

      const users = getUsers();
      const found = users.find(u => u.phone === phone && u.pin === pin);
      if (found) {
        state.currentUser = found;
        localStorage.setItem("mnq_current_user", JSON.stringify(found));
        state.screen = "customer";
        showToast("Berhasil masuk sebagai " + found.fullName);
        render();
      } else {
        showToast("Nomor HP atau PIN tidak ditemukan. Silakan Daftar Akun Baru.");
      }
    }

    function handlePhoneRegister() {
      const fullName = document.getElementById("regName").value.trim();
      const phone = document.getElementById("regPhone").value.trim();
      const pin = document.getElementById("regPin").value.trim();
      const gender = document.getElementById("regGender").value;
      const address = document.getElementById("regAddress").value.trim();

      if (!fullName || phone.length < 8 || pin.length < 4 || !address) {
        showToast("Mohon lengkapi seluruh kolom pendaftaran dengan benar.");
        return;
      }

      const newUser = { fullName, phone, pin, gender, address, email: "", photoUri: "" };
      const users = getUsers().filter(u => u.phone !== phone);
      users.unshift(newUser);
      saveUsers(users);

      state.currentUser = newUser;
      localStorage.setItem("mnq_current_user", JSON.stringify(newUser));
      state.screen = "customer";
      showToast("Pendaftaran berhasil! Selamat datang, " + fullName);
      render();
    }

    function handleGoogleQuickLogin() {
      const users = getUsers();
      const defaultUser = users[0];
      state.currentUser = defaultUser;
      localStorage.setItem("mnq_current_user", JSON.stringify(defaultUser));
      state.screen = "customer";
      showToast("Berhasil masuk dengan Akun Google");
      render();
    }

    function toggleService(srvId) {
      const cur = state.booking.services;
      if (cur[srvId]) {
        if (Object.keys(cur).length > 1) delete cur[srvId];
      } else {
        cur[srvId] = 1;
      }
      render();
    }

    function setServiceDur(srvId, dur) {
      state.booking.services[srvId] = dur;
      render();
    }

    function updateParticipant(type, delta) {
      let m = state.booking.maleCount;
      let f = state.booking.femaleCount;
      if (type === "male") {
        const nextM = m + delta;
        if (nextM >= 0 && nextM + f <= MAX_PARTICIPANTS && (nextM + f >= 1)) state.booking.maleCount = nextM;
      } else {
        const nextF = f + delta;
        if (nextF >= 0 && m + nextF <= MAX_PARTICIPANTS && (m + nextF >= 1)) state.booking.femaleCount = nextF;
      }
      render();
    }

    function submitBookingOrder() {
      const b = state.booking;
      const u = state.currentUser;
      const totalParticipants = b.maleCount + b.femaleCount;
      let costPerPerson = 0;
      const summaryParts = [];
      Object.entries(b.services).forEach(([id, dur]) => {
        const s = SERVICES.find(x => x.id === id);
        if (s) {
          costPerPerson += s.rate * dur;
          summaryParts.push(`${s.name} (${dur} Jam)`);
        }
      });
      const serviceCost = costPerPerson * totalParticipants;
      const transport = b.locationType === "Panggilan ke Rumah" ? TRANSPORT_FEE : 0;
      const totalPayment = serviceCost + transport;
      const orderId = "MNQ-" + b.bookingDate.replaceAll("-", "") + "-" + Math.floor(1000 + Math.random() * 9000);
      const address = b.locationType === "Datang ke Lokasi Pijat" ? OUTLET_ADDRESS : (b.customAddress || u.address);

      const newOrder = {
        orderId,
        customerName: u.fullName,
        customerPhone: u.phone,
        bookingDate: b.bookingDate,
        timeSlot: b.timeSlot,
        servicesSummary: summaryParts.join(", "),
        maleCount: b.maleCount,
        femaleCount: b.femaleCount,
        totalParticipants,
        locationType: b.locationType,
        serviceAddress: address,
        totalPayment,
        status: "PENDING_CONFIRMATION"
      };

      const orders = getOrders();
      orders.unshift(newOrder);
      saveOrders(orders);

      showToast("Pesanan " + orderId + " berhasil dibuat!");
      openWhatsAppForOrder(orderId);
      state.customerTab = 1;
      render();
    }

    function openWhatsAppForOrder(orderId) {
      const order = getOrders().find(o => o.orderId === orderId);
      if (!order) return;
      const msg = `Halo CS Mitra NetraQu Palembang, saya ingin konfirmasi pemesanan pijat:\n• No. Pesanan: ${order.orderId}\n• Nama Pemesan: ${order.customerName}\n• No. HP: ${order.customerPhone}\n• Jadwal: ${order.bookingDate} jam ${order.timeSlot}\n• Layanan: ${order.servicesSummary}\n• Peserta: ${order.maleCount} Pria, ${order.femaleCount} Wanita\n• Lokasi: ${order.locationType} (${order.serviceAddress})\n• Total Biaya: ${formatRupiah(order.totalPayment)}`;
      window.open(`https://wa.me/${state.csWhatsApp}?text=${encodeURIComponent(msg)}`, "_blank");
    }

    function adminChangeOrderStatus(orderId, newStatusCode) {
      const orders = getOrders().map(o => o.orderId === orderId ? { ...o, status: newStatusCode } : o);
      saveOrders(orders);
      const st = getStatusObj(newStatusCode);
      showToast(`Status pesanan ${orderId} diubah menjadi: ${st.label}`);
      render();
    }

    function handlePhotoUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        state.currentUser.photoUri = evt.target.result;
        localStorage.setItem("mnq_current_user", JSON.stringify(state.currentUser));
        const users = getUsers().map(u => u.phone === state.currentUser.phone ? state.currentUser : u);
        saveUsers(users);
        showToast("Foto profil berhasil diperbarui");
        render();
      };
      reader.readAsDataURL(file);
    }

    function updateUserGender(newGender) {
      state.currentUser.gender = newGender;
      localStorage.setItem("mnq_current_user", JSON.stringify(state.currentUser));
      const users = getUsers().map(u => u.phone === state.currentUser.phone ? state.currentUser : u);
      saveUsers(users);
      showToast("Jenis kelamin diubah menjadi " + newGender);
      render();
    }

    function logout() {
      localStorage.removeItem("mnq_current_user");
      state.currentUser = null;
      state.screen = "auth";
      render();
    }

    // Jalankan pertama kali
    render();
  </script>
</body>
</html>
